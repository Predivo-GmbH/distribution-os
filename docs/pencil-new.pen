                      "type": "text",
                      "id": "ssIAS",
                      "name": "p5desc",
                      "fill": "#475569",
                      "textGrowth": "fixed-width",
                      "width": 480,
                      "content": "The Distribution OS logo combines a geometric mark with a clean wordmark. The mark features three horizontal signal bars of increasing width inside a rounded indigo square — representing distribution channels and task progression.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "IOWNy",
                      "name": "p5r",
                      "fill": "#6366F1",
