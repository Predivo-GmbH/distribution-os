                    },
                    {
                      "type": "text",
                      "id": "cYzE0",
                      "name": "p5rd",
                      "fill": "#475569",
                      "textGrowth": "fixed-width",
                      "width": 480,
                      "content": "The three bars symbolize the structured, layered approach to distribution — tasks organized into clear, completable rows. The rounded square container represents the operating system frame. Electric Indigo signals intelligence, ambition, and modern SaaS tooling.",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
